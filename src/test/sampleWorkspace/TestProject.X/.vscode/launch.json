    "version": "0.2.0",
    "configurations": [
        {
            "type": "mdb",
            "request": "launch",
            "name": "Microchip Debug Adapter",
            "filePath": "${workspaceFolder}/dist/default/production/TestProject.X.production.elf",
            "device": "PIC18F46J53",
            "toolType": "SIM",
            "toolOptions": { },
            "stopOnEntry": true,
            "preLaunchTask": "MPLABX Build"
        },
        {
            "type": "mplabx",
            "request": "launch",
            "name": "MPLABX Debug",
            "program": "${workspaceFolder}",
            "stopOnEntry": true,
            "preLaunchTask": "MPLABX Build",
            "debug": false,
            "configuration": "default"
        },
        {
            "name": "Options Test",
            "type": "mdb",
            "request": "launch",
            "filePath": "${workspaceFolder}/dist/default/production/TestProject.X.production.elf",
            "device": "PIC16F1509",
            "toolType": "PICKit4",
            "toolOptions": {
                "programoptions.pgmentry.voltage": "high",
                "poweroptions.powerenable": "true",
                "voltagevalue": "5.0"
            },
            "stopOnEntry": true,
        },
    ]
}